---
import config from 'virtual:config'
---

{/* 首屏前用内联脚本决定主题，避免闪白。 */}
<script is:inline>
  ;(function () {
    var theme = localStorage.getItem('theme')
    if (!theme || theme === 'system') {
      theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }
    document.documentElement.classList.toggle('dark', theme === 'dark')
    document
      .querySelector('meta[name=\"theme-color\"]')
      ?.setAttribute('content', theme === 'dark' ? '#14141a' : '#F6F7F9')
  })()
</script>

<script is:inline>
  // Toast：只内联一条 info 图标，避免把整个图标库打进首屏。
  ;(function () {
    var infoIcon = '<g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"/><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 2a8 8 0 1 0 0 16a8 8 0 0 0 0-16m-.01 6c.558 0 1.01.452 1.01 1.01v5.124A1 1 0 0 1 12.5 18h-.49A1.01 1.01 0 0 1 11 16.99V12a1 1 0 1 1 0-2zM12 7a1 1 0 1 1 0 2a1 1 0 0 1 0-2"/></g>'
    document.addEventListener('toast', function (event) {
      var detail = event.detail || {}
      var toast = document.createElement('div')
      toast.className =
        'animate fixed bottom-8 z-20 px-4 py-2 bg-muted text-foreground rounded-lg border shadow-lg flex items-center gap-2'
      toast.setAttribute('role', 'status')
      toast.innerHTML =
        '<svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"currentColor\">' +
        infoIcon +
        '</svg><span></span>'
      var label = toast.querySelector('span')
      if (label) label.textContent = detail.message || ''
      document.body.appendChild(toast)
      window.setTimeout(function () {
        toast.remove()
      }, detail.time || 3000)
    })
  })()
</script>

<script>
  import { listenThemeChange } from 'astro-pure/utils'

  listenThemeChange()
</script>

