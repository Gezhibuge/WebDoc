---
import { cn } from 'astro-pure/utils'

interface Props {
  href: string
  label: string
  class?: string
  direction?: 'left' | 'right'
}

const { href, label, class: className, direction = 'right' } = Astro.props
---

<a
  {href}
  class={cn(
    'group inline-flex items-center gap-x-1 text-sm text-muted-foreground transition-colors duration-200 hover:text-foreground',
    className
  )}
  data-astro-prefetch
>
  <span>{label}</span>
  <svg
    xmlns='http://www.w3.org/2000/svg'
    width='16'
    height='16'
    viewBox='0 0 24 24'
    fill='none'
    stroke-width='2.5'
    stroke-linecap='round'
    stroke-linejoin='round'
    class:list={['shrink-0', direction === 'left' && 'rotate-180']}
    aria-hidden='true'
  >
    <line
      x1='5'
      y1='12'
      x2='19'
      y2='12'
      class='translate-x-4 scale-x-0 stroke-muted-foreground transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100 group-hover:stroke-primary'
    ></line>
    <polyline
      points='12 5 19 12 12 19'
      class='translate-x-0 stroke-muted-foreground transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:stroke-primary'
    ></polyline>
  </svg>
</a>
