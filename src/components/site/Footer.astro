---
import { Icon } from 'astro-pure/user'
import config from 'virtual:config'

import ui from '@/i18n/zh-CN'

const social = config.footer.social || []
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0'>
      <div class='flex flex-col gap-y-1 text-sm text-muted-foreground'>
        <p>{config.footer.year} {config.author} · 保留所有权利</p>
        <p class='flex flex-wrap items-center gap-x-2'>
          <span>{ui.footer.builtWith}</span>
          <span aria-hidden='true'>·</span>
          <a href='/about' class='underline underline-offset-4 hover:text-foreground'>关于本站</a>
        </p>
      </div>

      <div class='flex items-center gap-x-4'>
        {
          social.map(({ label, href, icon }) => (
            <a {href} rel='me' class='sl-flex' aria-label={label} title={label}>
              <span class='sr-only'>{label}</span>
              <Icon name={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
  }
</style>
