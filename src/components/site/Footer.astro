---
import { Icon } from 'astro-pure/user'
import config from 'virtual:config'

import ui from '@/i18n/zh-CN'

const social = config.footer.social || []
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0'>
      {/* 左侧：版权与主题信息，保持原来的位置 */}
      <div class='flex flex-col gap-y-1 text-sm text-muted-foreground max-sm:items-center max-sm:text-center'>
        <p>{config.footer.year} {config.author} · 保留所有权利</p>
        <p class='flex flex-wrap items-center gap-x-2'>
          <span>{ui.footer.builtWith}</span>
          <span aria-hidden='true'>·</span>
          <a href='/about' class='underline underline-offset-4 hover:text-foreground'>关于本站</a>
        </p>
      </div>

      {/* 右侧：B 站、GitHub、邮箱 */}
      <div class='footer-social flex items-center gap-3'>
        {
          social.map(({ label, href, icon }) => (
            <a
              href={href}
              target={href.startsWith('mailto:') ? undefined : '_blank'}
              rel={href.startsWith('mailto:') ? undefined : 'me noreferrer'}
              class='footer-social-link flex size-10 items-center justify-center rounded-full border border-transparent bg-muted text-muted-foreground transition-colors hover:border-border hover:text-primary'
              aria-label={label}
              title={label}
            >
              <Icon name={icon} class='size-5' />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
  }

  .footer-social-link {
    transition:
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      box-shadow 220ms ease;
  }

  .footer-social-link:hover {
    transform: translateY(-3px);
    background-color: hsl(var(--primary) / 0.1);
    box-shadow: 0 7px 18px hsl(var(--primary) / 0.12);
  }

  .footer-social-link svg {
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .footer-social-link:nth-child(1):hover svg {
    transform: rotate(-8deg) scale(1.1);
  }

  .footer-social-link:nth-child(2):hover svg {
    transform: rotate(8deg) scale(1.1);
  }

  .footer-social-link:nth-child(3):hover svg {
    transform: translateY(-1px) scale(1.08);
  }
</style>
