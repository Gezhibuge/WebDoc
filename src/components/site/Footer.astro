---
import { Icon } from 'astro-pure/user'
import config from 'virtual:config'

import ui from '@/i18n/zh-CN'

const social = config.footer.social || []
---

<footer class='mx-auto mb-5 mt-16 w-full'>
  <div class='border-t pt-5'>
    <div class='flex flex-col gap-5'>
      {/* 社交/联系入口：B 站、邮箱、GitHub */}
      <div class='flex items-center justify-center gap-6'>
        {
          social.map(({ label, href, icon }) => (
            <a
              href={href}
              target={href.startsWith('mailto:') ? undefined : '_blank'}
              rel={href.startsWith('mailto:') ? undefined : 'me noreferrer'}
              class='flex size-10 items-center justify-center rounded-full border border-transparent bg-muted text-muted-foreground transition-colors hover:border-border hover:text-primary'
              aria-label={label}
              title={label}
            >
              <Icon name={icon} class='size-5' />
            </a>
          ))
        }
      </div>

      <div class='flex items-center gap-y-2 max-sm:flex-col sm:justify-between'>
        <p class='text-sm text-muted-foreground'>{config.footer.year} {config.author} · 保留所有权利</p>
        <p class='flex flex-wrap items-center justify-center gap-x-2 text-sm text-muted-foreground'>
          <span>{ui.footer.builtWith}</span>
          <span aria-hidden='true'>·</span>
          <a href='/about' class='underline underline-offset-4 hover:text-foreground'>关于本站</a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
  }
</style>
