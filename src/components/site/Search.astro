---
import '@pagefind/default-ui/css/ui.css'
import ui from '@/i18n/zh-CN'
---

<site-search>
  <aside class='form my-4'>
    {
      import.meta.env.DEV ? (
        <div class='w-full rounded-xl border-2 bg-transparent px-4 py-2 pe-3 outline-none focus:border-foreground'>
          {ui.search.devMode}
        </div>
      ) : (
        <div id='site-search' />
      )
    }
  </aside>

  {
    !import.meta.env.DEV && (
      <div class='search-date-row'>
        <div class='search-date'>
          <button
            id='search-date-trigger'
            type='button'
            class='search-date-trigger'
            aria-haspopup='dialog'
            aria-expanded='false'
            aria-controls='search-calendar'
          >
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='16'
              height='16'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <rect x='3' y='4' width='18' height='18' rx='2' />
              <path d='M16 2v4M8 2v4M3 10h18' />
            </svg>
            <span>按日期搜索</span>
            <svg
              xmlns='http://www.w3.org/2000/svg'
              width='14'
              height='14'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2.2'
              stroke-linecap='round'
              stroke-linejoin='round'
              class='search-date-chevron'
              aria-hidden='true'
            >
              <path d='m6 9 6 6 6-6' />
            </svg>
          </button>

          <dialog
            id='search-calendar'
            class='search-calendar'
            aria-label='按发布日期筛选'
            aria-hidden='true'
          >
            <div class='calendar-head'>
              <button type='button' id='calendar-prev' class='calendar-nav' aria-label='上个月'>
                <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='m15 18-6-6 6-6' /></svg>
              </button>
              <span id='calendar-month' class='calendar-month'></span>
              <button type='button' id='calendar-next' class='calendar-nav' aria-label='下个月'>
                <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='m9 18 6-6-6-6' /></svg>
              </button>
            </div>
            <div class='calendar-weekdays'>
              {['日', '一', '二', '三', '四', '五', '六'].map((day) => <span>{day}</span>)}
            </div>
            <div id='calendar-days' class='calendar-days'></div>
            <div class='calendar-foot'>
              <span id='calendar-selected' class='calendar-selected'>未选择日期</span>
              <button type='button' id='calendar-clear' class='calendar-clear'>
                清除
              </button>
            </div>
          </dialog>
        </div>
        <span id='search-date-status' class='search-date-status' aria-live='polite' />
      </div>
    )
  }
</site-search>

<script>
  const formatURL = (path: string) => {
    const [base, hash] = path.split('#')
    const clean = base.replace(/\/index\.html$/, '/').replace(/\.html$/, '')
    return hash ? `${clean}#${hash}` : clean
  }

  class SiteSearch extends HTMLElement {
    connectedCallback() {
      const setupDateFilter = () => {
        const trigger = document.querySelector<HTMLButtonElement>('#search-date-trigger')
        const calendar = document.querySelector<HTMLDialogElement>('#search-calendar')
        const monthLabel = document.querySelector<HTMLElement>('#calendar-month')
        const days = document.querySelector<HTMLElement>('#calendar-days')
        const selectedLabel = document.querySelector<HTMLElement>('#calendar-selected')
        const status = document.querySelector<HTMLElement>('#search-date-status')
        const clear = document.querySelector<HTMLButtonElement>('#calendar-clear')
        const prev = document.querySelector<HTMLButtonElement>('#calendar-prev')
        const next = document.querySelector<HTMLButtonElement>('#calendar-next')
        const dateMapElement = document.querySelector<HTMLScriptElement>('#post-dates')
        if (
          !trigger ||
          !calendar ||
          !monthLabel ||
          !days ||
          !selectedLabel ||
          !status ||
          !clear ||
          !prev ||
          !next ||
          !dateMapElement
        )
          return

        let postDates: Record<string, string> = {}
        try {
          postDates = JSON.parse(dateMapElement.textContent || '{}')
        } catch {
          postDates = {}
        }
        const availableDates = new Set(Object.values(postDates))
        const latestDate = [...availableDates].sort().at(-1)
        let selectedDate = ''
        let cursor = new Date(`${latestDate || new Date().toISOString().slice(0, 10)}T00:00:00`)

        const pad = (value: number) => String(value).padStart(2, '0')
        const toISO = (year: number, month: number, day: number) =>
          `${year}-${pad(month + 1)}-${pad(day)}`
        const normalizePath = (href: string) => {
          try {
            return new URL(href, location.origin).pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '')
          } catch {
            return href.split('#')[0]
          }
        }

        const initialDate = new URLSearchParams(location.search).get('date')
        if (initialDate && availableDates.has(initialDate)) {
          selectedDate = initialDate
          cursor = new Date(`${initialDate}T00:00:00`)
        }

        const applyDateFilter = () => {
          const hasDate = Boolean(selectedDate)
          document.documentElement.classList.toggle('has-date-filter', hasDate)
          trigger.classList.toggle('has-value', hasDate)

          let staticCount = 0
          document.querySelectorAll<HTMLElement>('#all-posts > ul > li').forEach((item) => {
            const visible = !hasDate || item.dataset.publishDate === selectedDate
            item.hidden = !visible
            if (visible) staticCount += 1
          })

          let resultCount = 0
          document.querySelectorAll<HTMLElement>('#site-search .pagefind-ui__result').forEach((item) => {
            const link = item.querySelector<HTMLAnchorElement>('.pagefind-ui__result-link')
            const visible =
              !hasDate || postDates[normalizePath(link?.getAttribute('href') || '')] === selectedDate
            item.hidden = !visible
            if (visible) resultCount += 1
          })

          const query = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.value.trim()
          const count = query ? resultCount : staticCount
          const allPostsCount = document.querySelector<HTMLElement>('#all-posts-count')
          if (allPostsCount) allPostsCount.textContent = `${staticCount} 篇`
          status.textContent = hasDate ? `已筛选 · ${count} 篇` : ''
          selectedLabel.textContent = hasDate ? `已选 ${selectedDate}` : '未选择日期'
        }

        const syncDate = () => {
          applyDateFilter()
          const url = new URL(location.href)
          if (selectedDate) url.searchParams.set('date', selectedDate)
          else url.searchParams.delete('date')
          history.replaceState(null, '', url)
        }

        const closeCalendar = () => {
          if (calendar.open) calendar.close()
          calendar.setAttribute('aria-hidden', 'true')
          trigger.setAttribute('aria-expanded', 'false')
        }

        const renderCalendar = () => {
          const year = cursor.getFullYear()
          const month = cursor.getMonth()
          monthLabel.textContent = `${year}年${month + 1}月`
          days.innerHTML = ''

          const firstDay = new Date(year, month, 1).getDay()
          const dayCount = new Date(year, month + 1, 0).getDate()

          for (let index = 0; index < firstDay; index += 1) {
            days.appendChild(document.createElement('span'))
          }

          for (let day = 1; day <= dayCount; day += 1) {
            const iso = toISO(year, month, day)
            const button = document.createElement('button')
            button.type = 'button'
            button.className = 'calendar-day'
            button.textContent = String(day)
            button.dataset.date = iso
            button.disabled = !availableDates.has(iso)
            button.setAttribute(
              'aria-label',
              availableDates.has(iso) ? `${iso}，有文章` : `${iso}，没有文章`
            )
            if (selectedDate === iso) button.classList.add('is-selected')
            if (availableDates.has(iso)) button.classList.add('is-available')
            days.appendChild(button)
          }
        }

        const openCalendar = () => {
          if (selectedDate) cursor = new Date(`${selectedDate}T00:00:00`)
          else if (latestDate) cursor = new Date(`${latestDate}T00:00:00`)
          renderCalendar()

          // 原生 dialog 处于 top layer，不受 Pagefind/内容区层叠上下文影响。
          calendar.showModal()
          calendar.setAttribute('aria-hidden', 'false')
          trigger.setAttribute('aria-expanded', 'true')
        }

        trigger.addEventListener('click', () => {
          if (calendar.open) closeCalendar()
          else openCalendar()
        })

        prev.addEventListener('click', () => {
          cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1)
          renderCalendar()
        })
        next.addEventListener('click', () => {
          cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1)
          renderCalendar()
        })

        days.addEventListener('click', (event) => {
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-date]')
          if (!button || button.disabled) return
          selectedDate = button.dataset.date || ''
          syncDate()
          closeCalendar()
          trigger.focus()
        })

        clear.addEventListener('click', () => {
          selectedDate = ''
          syncDate()
          closeCalendar()
          trigger.focus()
        })

        calendar.addEventListener('click', (event) => {
          if (event.target === calendar) closeCalendar()
        })

        calendar.addEventListener('close', () => {
          calendar.setAttribute('aria-hidden', 'true')
          trigger.setAttribute('aria-expanded', 'false')
          trigger.focus()
        })

        const mount = document.querySelector<HTMLElement>('#site-search')
        if (mount) {
          let filterTimer: number | undefined
          const observer = new MutationObserver(() => {
            window.clearTimeout(filterTimer)
            filterTimer = window.setTimeout(applyDateFilter, 30)
          })
          observer.observe(mount, { childList: true, subtree: true })
        }

        renderCalendar()
        applyDateFilter()
      }

      setupDateFilter()

      const init = async () => {
        const mount = document.querySelector<HTMLElement>('#site-search')
        if (!mount) return

        // 清掉骨架屏，避免 Pagefind 初始化后残留
        mount.innerHTML = ''
        // @ts-expect-error — Pagefind UI 没有提供完整类型
        const { PagefindUI } = await import('@pagefind/default-ui')
        new PagefindUI({
          element: '#site-search',
          baseUrl: import.meta.env.BASE_URL,
          bundlePath: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/`,
          showImages: false,
          showSubResults: true,
          translations: {
            placeholder: '输入关键词，搜索本站的文章，或者随便输入点什么……',
            clear_search: '×',
            load_more: '加载更多结果',
            search_label: '站内搜索',
            filters_label: '筛选',
            zero_results: '未找到 [SEARCH_TERM] 的相关结果',
            many_results: '找到 [COUNT] 条 [SEARCH_TERM] 的相关结果',
            one_result: '找到 [COUNT] 条 [SEARCH_TERM] 的相关结果',
            total_zero_results: '无结果',
            total_one_result: '[COUNT] 条结果',
            total_many_results: '[COUNT] 条结果',
            alt_search: '未找到 [SEARCH_TERM] 的相关结果，改为显示 [DIFFERENT_TERM] 的相关结果',
            search_suggestion: '未找到 [SEARCH_TERM] 的相关结果，请尝试以下搜索词',
            searching: '正在搜索 [SEARCH_TERM]…',
            results_label: '搜索结果',
            keyboard_navigate: '导航',
            keyboard_select: '选择',
            keyboard_clear: '清除',
            keyboard_close: '关闭',
            keyboard_search: '搜索',
            error_search: '搜索失败',
            filter_selected_one: '已选择 [COUNT] 个',
            filter_selected_many: '已选择 [COUNT] 个',
            input_hint: '输入时将显示结果'
          },
          processResult: (result: { url: string; sub_results: Array<{ url: string }> }) => {
            result.url = formatURL(result.url)
            result.sub_results = result.sub_results.map((sub_result) => {
              sub_result.url = formatURL(sub_result.url)
              return sub_result
            })
          }
        })

        // 日期筛选保持在搜索框上方。Pagefind 在查询时会重排自己的 DOM，
        // 放在它内部会被结果区推走，所以不要塞进 Pagefind 容器。
        // 预加载索引和 worker，避免第一次输入时才去加载，减少“正在搜索”的等待。
        // 日期筛选放进 Pagefind 的表单内、结果区之前，保持在搜索框下方。
        const dateRow = document.querySelector<HTMLElement>('.search-date-row')
        const drawer = mount.querySelector<HTMLElement>('.pagefind-ui__drawer')
        if (dateRow && drawer?.parentElement) {
          drawer.parentElement.insertBefore(dateRow, drawer)
        }

        const pagefindPath = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/pagefind/pagefind.js`
        void import(/* @vite-ignore */ pagefindPath)
          .then((pagefind: { init?: () => Promise<void> }) => pagefind.init?.())
          .catch(() => {})

        window.requestAnimationFrame(() => {
          mount
            .querySelector('.pagefind-ui__search-clear')
            ?.setAttribute('aria-label', '清除搜索')
          mount
            .querySelector('.pagefind-ui__search-input')
            ?.setAttribute('aria-label', '搜索文章')
        })
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init, { once: true })
      } else {
        init()
      }
    }
  }
  customElements.define('site-search', SiteSearch)
</script>

<style>
  #site-search {
    --pagefind-ui-scale: 0.8;
    --pagefind-ui-primary: hsl(var(--primary) / var(--un-bg-opacity, 1));
    --pagefind-ui-text: hsl(var(--foreground) / var(--un-text-opacity, 1));
    --pagefind-ui-background: hsl(var(--muted) / var(--un-bg-opacity, 1));
    --pagefind-ui-border: hsl(var(--border) / var(--un-border-opacity, 1));
    --pagefind-ui-tag: hsl(var(--muted-foreground) / var(--un-text-opacity, 1));
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-border-radius: calc(var(--radius) + 2px);
    --pagefind-ui-image-border-radius: calc(var(--radius) + 2px);
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: sans-serif;
  }
</style>
