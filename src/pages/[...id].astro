---
import { render, type CollectionEntry } from 'astro:content'

import { GithubCard, LinkPreview, Quote } from 'astro-pure/advanced'
import {
  Aside,
  Card,
  Collapse,
  Spoiler,
  Steps,
  TabItem,
  Tabs,
  Timeline
} from 'astro-pure/user'
import ArticleRenderError from '@/components/blog/ArticleRenderError.astro'
import Download from '@/components/blog/Download.astro'
import PostLayout from '@/layouts/BlogPost.astro'
import { getBlogPosts, getPostSlug } from '@/utils/blog'

// MDX 文章的全局组件：在 Pages CMS 里写 <Aside>、<Tabs> 等不需要手动 import。
const mdxComponents = {
  Aside,
  Card,
  Collapse,
  Spoiler,
  Steps,
  TabItem,
  Tabs,
  Timeline,
  GithubCard,
  LinkPreview,
  Quote,
  Download
}

export const prerender = true

/**
 * 文章根路径路由：
 * - slug 存在时：/123、/update/123
 * - 没有 slug 时回退到内容 id：/hello
 *
 * slug 会先统一转小写，所以 /Update/123 和 /update/123 是同一个地址。
 * 旧链接不在这里生成，而是由重定向集成在构建后写入静态跳转页。
 */
export async function getStaticPaths() {
  const posts = await getBlogPosts()
  const seen = new Set<string>()

  return posts.map((post) => {
    const id = getPostSlug(post)
    if (seen.has(id)) {
      throw new Error(
        `文章 slug 重复：${id}。注意 slug 不区分大小写，/ABC 和 /abc 会被视为同一个链接，请修改其中一篇。`
      )
    }
    seen.add(id)

    return {
      params: { id },
      props: { post, posts }
    }
  })
}

type Props = {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
}

const { post, posts } = Astro.props

let rendered: Awaited<ReturnType<typeof render>> | undefined
let renderError = ''
try {
  rendered = await render(post)
} catch (error) {
  renderError = error instanceof Error ? error.message : String(error)
  console.error(`[文章渲染失败] ${post.id}\n${renderError}`)
}

const Content = rendered?.Content
const headings = rendered?.headings ?? []
const remarkPluginFrontmatter = rendered?.remarkPluginFrontmatter ?? {}
---

<PostLayout {post} {posts} {headings} {remarkPluginFrontmatter}>
  {
    renderError ? (
      <ArticleRenderError message={renderError} />
    ) : Content ? (
      <Content components={mdxComponents} />
    ) : null
  }
</PostLayout>
