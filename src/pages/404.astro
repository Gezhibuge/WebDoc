---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ui from '@/i18n/zh-CN'

const meta = {
  description: ui.notFound.description,
  title: ui.notFound.title
}
---

<PageLayout {meta}>
  <div class='px-4 py-10 text-center sm:px-6 lg:px-8'>
    <h1 class='block text-7xl font-bold sm:text-9xl'>404</h1>
    <p class='mt-3 text-muted-foreground'>{ui.notFound.message}</p>
    <Button title={ui.notFound.backHome} href='/' variant='ahead' class='mt-5' />
  </div>
</PageLayout>
