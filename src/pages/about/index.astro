---
import { getEntry, render } from 'astro:content'

import { Button } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

const entry = await getEntry('pages', 'about')
if (!entry) throw new Error('缺少 src/content/pages/about.md')

const { Content } = await render(entry)
const { title, description } = entry.data
---

<PageLayout meta={{ title, description }}>
  <Button title='返回首页' href='/' variant='back' />

  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='text-3xl font-medium'>{title}</h1>
    </div>

    <div
      id='content'
      class={cn('animate mt-8 max-w-none md:min-w-[45ch]', integ.typography.class)}
    >
      <Content />
    </div>
  </main>
</PageLayout>
