---
import HomeView from '@/components/home/HomeView.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'
import { getBlogPosts } from '@/utils/blog'

const PAGE_SIZE = 5
const allPosts = await getBlogPosts()
const pinnedPosts = allPosts.filter((post) => post.data.pin)
const regularPosts = allPosts.filter((post) => !post.data.pin)
const totalPages = Math.max(1, Math.ceil(regularPosts.length / PAGE_SIZE))
const posts = regularPosts.slice(0, PAGE_SIZE)
---

<PageLayout meta={{ title: '首页', description: config.description }} highlightColor='#659EB9'>
  <HomeView {pinnedPosts} {posts} currentPage={1} {totalPages} />
</PageLayout>
