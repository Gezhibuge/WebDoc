---
import { ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import Footer from '@/components/site/Footer.astro'
import Header from '@/components/site/Header.astro'
import config from '@/site-config'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  hideScrollbar?: boolean
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  // 所有页面共用一层很淡的蓝色氛围背景，避免标签/归档等短页面显得空。
  highlightColor = '#659EB9',
  hideScrollbar = false,
  ...props
} = Astro.props
---

<html lang={config.locale.lang} class={hideScrollbar ? 'hide-scrollbar' : undefined}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body class='flex justify-center bg-background text-foreground' {...props}>
    {
      highlightColor && (
        <div
          id='highlight-gradient'
          class='pointer-events-none absolute start-0 top-0 z-0 h-screen w-full opacity-25'
          style={`background-image:linear-gradient(${highlightColor},transparent)`}
        />
      )
    }
    <div
      id='main-container'
      class='w-full max-w-[70rem] min-h-[100dvh] flex flex-col justify-between'
    >
      <Header />
      <div class='flex-1 w-full page-enter'>
        <slot />
      </div>
      <Footer />
    </div>

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        --highlight-fg: color-mix(
          in srgb,
          var(--highlightColor) 40%,
          hsl(var(--foreground)/var(--un-text-opacity, 1))
        );
        color: var(--highlight-fg, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }

      /* Extend safe area for some special screens
       * https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/env
       * https://webkit.org/blog/7929/designing-websites-for-iphone-x/
       */
      #main-container {
        padding-top: env(safe-area-inset-top);
        padding-left: calc(1rem + env(safe-area-inset-left));
        padding-right: calc(1rem + env(safe-area-inset-right));
      }
      @media (min-width: 640px) {
        #main-container {
          padding-left: calc(1.75rem + env(safe-area-inset-left));
          padding-right: calc(1.75rem + env(safe-area-inset-right));
        }
      }
      @media (min-width: 1024px) {
        #main-container {
          padding-left: calc(2.5rem + env(safe-area-inset-left));
          padding-right: calc(2.5rem + env(safe-area-inset-right));
        }
      }
    </style>

    <script>
      import { showToast } from 'astro-pure/utils'

      let lastCopyToast = 0
      document.addEventListener('copy', () => {
        const selected = window.getSelection()?.toString().trim()
        if (!selected) return
        const now = Date.now()
        if (now - lastCopyToast < 800) return
        lastCopyToast = now
        showToast({ message: '复制成功！' })
      })

      // Starlight 的标签页在切换时会 focus 新标签并校正 scroll。
      // 这里记录点击前的滚动位置，切换完成后恢复，避免页面被拉回顶部。
      type LenisControl = {
        stop: () => void
        start: () => void
        scrollTo: (target: number, options?: { immediate?: boolean }) => void
      }
      const getLenis = () =>
        (window as Window & { __lenis?: LenisControl }).__lenis ?? null
      // 代码块的折叠按钮：用 height 动画展开/收起，而不是直接切换 max-height。
      ;(
        window as Window & {
          __toggleCodeCollapse?: (button: HTMLElement) => void
        }
      ).__toggleCodeCollapse = (button: HTMLElement) => {
        const panel = button.parentElement
        const pre = panel?.querySelector('pre')
        if (!panel || !pre) return
        const collapsed = panel.classList.contains('collapsed')
        const startHeight = pre.getBoundingClientRect().height
        const rootFontSize = Number.parseFloat(
          getComputedStyle(document.documentElement).fontSize
        ) || 16
        const targetHeight = collapsed ? pre.scrollHeight : 15 * rootFontSize

        panel.classList.toggle('collapsed')
        button.setAttribute('aria-expanded', String(!panel.classList.contains('collapsed')))
        pre.style.maxHeight = 'none'
        pre.style.overflow = 'hidden'
        pre.style.height = `${startHeight}px`

        if (typeof pre.animate !== 'function') {
          pre.style.height = ''
          pre.style.maxHeight = ''
          pre.style.overflow = ''
          return
        }

        const animation = pre.animate(
          [{ height: `${startHeight}px` }, { height: `${targetHeight}px` }],
          {
            duration: 300,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)'
          }
        )
        animation.onfinish = () => {
          pre.style.height = ''
          pre.style.maxHeight = ''
          pre.style.overflow = ''
        }
      }

      let tabScrollY: number | null = null
      document.addEventListener(
        'click',
        (event) => {
          const target = event.target
          if (!(target instanceof Element)) return
          if (!target.closest('starlight-tabs [role="tab"]')) return
          tabScrollY = window.scrollY
          // 标签页切换会触发 window.scrollTo；暂停 Lenis，避免它继续做平滑滚动。
          getLenis()?.stop()
        },
        true
      )
      document.addEventListener('click', (event) => {
        const target = event.target
        if (tabScrollY === null || !(target instanceof Element)) return
        if (!target.closest('starlight-tabs [role="tab"]')) return
        const scrollY = tabScrollY
        tabScrollY = null
        const lenis = getLenis()
        const restoreScroll = () => {
          window.scrollTo({ top: scrollY, left: 0, behavior: 'auto' })
          lenis?.scrollTo(scrollY, { immediate: true })
        }
        restoreScroll()
        // focus() 可能在本轮事件结束后才触发滚动，下一帧再校正一次。
        window.requestAnimationFrame(() => {
          restoreScroll()
          lenis?.start()
        })
      })

      // 轻微惯性：lerp 越接近 1 越跟手；0.18 只加一点缓冲，不会“滑冰”。
      // 延迟加载，优先保证首屏可交互；短页面不加载平滑滚动。
      if (
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        document.documentElement.scrollHeight > window.innerHeight + 80
      ) {
        const idle =
          window.requestIdleCallback ??
          ((callback: IdleRequestCallback) => window.setTimeout(callback, 200))

        idle(
          async () => {
            try {
              const { default: Lenis } = await import('lenis')
              const lenis = new Lenis({
                // 保留轻微惯性，但提高跟随速度，减少“拖一下才动”的卡顿感。
                lerp: 0.2,
                wheelMultiplier: 0.95,
                smoothWheel: true,
                anchors: true
              })
              ;(window as Window & { __lenis?: typeof lenis }).__lenis = lenis
              const raf = (time: number) => {
                lenis.raf(time)
                window.requestAnimationFrame(raf)
              }
              window.requestAnimationFrame(raf)
            } catch {
              // 平滑滚动加载失败时保留浏览器原生滚动。
            }
          },
          { timeout: 1200 }
        )
      }
    </script>
  </body>
</html>
