    "@pagefind/default-ui": "1.6.0",
    "@shikijs/core": "4.6.0",
    "@shikijs/types": "4.6.0",
    "@unocss/astro": "66.12.0",
    "@unocss/preset-typography": "66.12.0",
    "@unocss/reset": "66.12.0",
    "@waline/client": "^3.15.2",
    "astro": "6.4.8",
    "astro-pure": "1.4.9",
    "hastscript": "9.0.3",
    "katex": "^0.16.47",
    "lenis": "^1.3.27",
