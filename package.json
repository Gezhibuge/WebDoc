    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "^0.34.5",
    "shiki": "4.6.0",
    "typescript": "^6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "unocss": "66.12.0"
